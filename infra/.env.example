# ==============================================================================
# CAREERPILOT: MASTER ENVIRONMENT VARIABLE CONFIGURATION TEMPLATE
# Copy to .env in local dev: `cp .env.example .env`
# ==============================================================================

# Core Ports
FRONTEND_PORT=3000
AUTH_PORT=5001
PROFILE_PORT=5002
ORCHESTRATOR_PORT=8000
GITHUB_MCP_PORT=5005
JOB_BOARD_MCP_PORT=5006

# Databases
MONGO_PORT=27017
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=secret123
MONGO_URI_AUTH=mongodb://admin:secret123@localhost:27017/careerpilot_auth?authSource=admin
MONGO_URI_PROFILE=mongodb://admin:secret123@localhost:27017/careerpilot_profile?authSource=admin

REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme
NEO4J_URI=bolt://localhost:7687

CHROMA_PORT=8001
CHROMA_HOST=localhost

# Security & Authentication
JWT_ACCESS_SECRET=your_super_secret_access_jwt_key_32_characters_minimum
JWT_REFRESH_SECRET=your_super_secret_refresh_jwt_key_32_characters_minimum
INTERNAL_SERVICE_KEY=careerpilot_internal_agent_secret_key_2026
CLIENT_ORIGIN=http://localhost:3000

# AI Models & External Providers
GROQ_API_KEY=your_groq_api_key_here
HF_API_KEY=your_huggingface_api_key_here
GITHUB_TOKEN=your_optional_github_token_here
MCP_OFFLINE_MODE=false
