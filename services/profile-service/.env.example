# CareerPilot Profile Service Environment Variables
PORT=5002
NODE_ENV=development

# MongoDB Connection String
MONGO_URI=mongodb://localhost:27017/careerpilot_profile

# JWT Secret (Must match Auth Service JWT_ACCESS_SECRET)
JWT_ACCESS_SECRET=your_super_secret_access_jwt_key_32_characters_minimum

# Internal Service Security Token (For Agent Orchestrator ingestion)
INTERNAL_SERVICE_KEY=careerpilot_internal_agent_secret_key_2026

# Allowed Frontend Origins
CLIENT_ORIGIN=http://localhost:3000
