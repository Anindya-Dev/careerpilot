# CareerPilot Auth Service Environment Variables
PORT=5001
NODE_ENV=development

# MongoDB Connection String
MONGO_URI=mongodb://localhost:27017/careerpilot_auth

# JWT Secrets & Expiry Windows
JWT_ACCESS_SECRET=your_super_secret_access_jwt_key_32_characters_minimum
JWT_REFRESH_SECRET=your_super_secret_refresh_jwt_key_32_characters_minimum
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Security Configuration
BCRYPT_SALT_ROUNDS=12
CLIENT_ORIGIN=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=10
